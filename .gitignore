# Secrets and local overrides
.env
.env.local
.local_secrets/
.local_backups/
paths.yaml
config/paths.yaml
.cursor/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Raw and interim data are downloaded/generated locally (never push)
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep

data/interim/**
!data/interim/**/
!data/interim/**/.gitkeep

# Ship manuscript figures, tables, and rasters under outputs/
# (ignore any other local output clutter)
outputs/**
!outputs/**/
!outputs/**/.gitkeep
!outputs/figures/**
!outputs/tables/**
!outputs/rasters/**

# Ship arid-domain boundary shapefiles and groundwater CSVs under processed/
# (ignore any other processed clutter)
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep
!data/processed/groundwater/**
!data/processed/boundaries/**

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Misc
*.log
neff_diagnostic.png
.env.example.bak
